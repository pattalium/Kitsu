# HTTPS origin of the Rust Kitsu backend; no trailing slash.
VITE_KITSU_API_BASE=https://api.k32.run

# Canonical public identities. The web process remains local and is exposed
# through Cloudflare Tunnel.
VITE_KITSU_PUBLIC_ORIGIN=https://k32.run
VITE_KITSU_APP_ORIGIN=https://app.k32.run

# Public source and self-host documentation.
VITE_KITSU_SERVER_REPOSITORY_URL=https://github.com/pattalium/Kitsu
