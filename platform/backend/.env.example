# Production example for the k32.run deployment. Local development may use
# http://localhost:8080; every hostname remains configuration, not code.
KITSU_PUBLIC_BASE_URL=https://api.k32.run
KITSU_PUBLIC_BIND=127.0.0.1:8080
KITSU_OPS_BIND=127.0.0.1:9090
KITSU_DATABASE_URL=postgres://kitsu:change-me@127.0.0.1:5432/kitsu
KITSU_DATABASE_MAX_CONNECTIONS=20

# Ordinary .k868 bytes live here as backend-private runtime data. This path
# must be absolute, readable only by the backend service, and outside every
# nginx/public-site root.
KITSU_PET_PACK_DIR=/var/lib/kitsu-backend/pet-packs/releases/replace-with-release-id

# External OpenID Connect issuer. The backend is never a password authority.
KITSU_OIDC_ISSUER=https://identity.example.com/
KITSU_OIDC_API_AUDIENCE=https://api.k32.run
KITSU_OIDC_NATIVE_CLIENT_ID=kitsu-native
KITSU_OIDC_BROWSER_CLIENT_ID=kitsu-web-bff
KITSU_OIDC_BROWSER_CLIENT_SECRET=load-from-secret-manager
KITSU_OIDC_REQUIRED_SCOPE=kitsu:companion

# Only the authenticated companion Web UI belongs here. Never add the public
# project/flasher site. Origins are comma-separated and exact (no wildcards).
KITSU_BROWSER_ALLOWED_ORIGINS=https://app.k32.run
KITSU_BROWSER_DEFAULT_RETURN_URL=https://app.k32.run/
# 32 random bytes, unpadded base64url, supplied by the deployment secret store.
KITSU_BROWSER_STATE_KEY=replace-with-base64url-32-byte-key
KITSU_BROWSER_SESSION_HOURS=12

# AWS KMS key used only to generate/wrap data-encryption keys. Companion HMAC
# secrets are encrypted locally with a generated DEK and AES-256-GCM.
KITSU_KMS_KEY_ID=alias/kitsu-companion-secrets

# AWS Private CA must be active and permit IssueCertificate/GetCertificate.
# This API-passthrough client-auth template lets the service inject the one
# exact urn:kitsu:{companion|gateway}:<uuid> SAN assigned by the backend.
KITSU_PRIVATE_CA_ARN=arn:aws:acm-pca:eu-central-1:123456789012:certificate-authority/replace-me
KITSU_PRIVATE_CA_API_PASSTHROUGH_TEMPLATE_ARN=arn:aws:acm-pca:::template/EndEntityClientAuthCertificate_APIPassthrough/V1
KITSU_CERTIFICATE_VALIDITY_DAYS=30
KITSU_CERTIFICATE_ISSUE_TIMEOUT_SECONDS=60

# Gateway machine traffic does not traverse Cloudflare. A private local Envoy
# listener directly terminates gateway mTLS, strips incoming identity headers,
# validates the configured gateway CA/revocation policy, and injects these
# values itself. The backend requires both that listener's narrowly isolated
# source address and a 32-byte random credential from the deployment secret
# store. Public nginx must hard-deny every /v1/gateway/* route.
KITSU_TRUSTED_MTLS_PROXY_CIDRS=127.0.0.1/32,::1/128
KITSU_MTLS_PROXY_AUTH_HEADER=x-kitsu-proxy-auth
KITSU_MTLS_PROXY_AUTH_TOKEN=replace-with-base64url-32-byte-random-token
# Envoy JSON-format XFCC, SANITIZE_SET, with cert:true and uri:true.
KITSU_MTLS_XFCC_HEADER=x-forwarded-client-cert

# Accommodates a 256 KiB decoded payload after base64url expansion plus the
# bounded JSON envelope. Decoded payload validation remains exactly 256 KiB.
KITSU_MAX_REQUEST_BYTES=393216
KITSU_ENROLLMENT_TTL_SECONDS=600
KITSU_GATEWAY_BOOTSTRAP_TTL_SECONDS=600
KITSU_CERTIFICATE_ROTATION_TTL_SECONDS=600
# Both old and replacement gateway certificates work during this bounded
# reconnect window. The old certificate is denied automatically afterwards.
KITSU_CERTIFICATE_OVERLAP_SECONDS=900
KITSU_ACTION_MAX_TTL_SECONDS=86400
KITSU_LOG_FILTER=kitsu_platform_backend=info,tower_http=info
