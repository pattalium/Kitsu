# Public mode is a separate service/container with separate identities and WAL.
# Deliberately invalid: replace with this public instance's provisioned UUID.
KITSU_GATEWAY_ID=00000000-0000-0000-0000-000000000000
KITSU_DEPLOYMENT_SCOPE=public
KITSU_LISTEN=0.0.0.0:7443
KITSU_BOOTSTRAP_LISTEN=0.0.0.0:7442
KITSU_ADMIN_LISTEN=127.0.0.1:7444
KITSU_PUBLIC_NAME=Kitsu Public Gateway
KITSU_SERVER_CERT=/etc/kitsu/public/secrets/gateway-server.crt.pem
KITSU_SERVER_KEY=/etc/kitsu/public/secrets/gateway-server.key.pem
KITSU_DEVICE_CA=/etc/kitsu/public/secrets/device-ca.crt.pem
KITSU_BACKEND_URL=https://api.example.invalid
# Set only when the hosted backend uses a private CA.
# KITSU_BACKEND_CA=/etc/kitsu/public/secrets/backend-ca.crt.pem
KITSU_GATEWAY_CLIENT_IDENTITY=/etc/kitsu/public/secrets/gateway-client-identity.pem
KITSU_PUBLIC_INSTANCE_MANIFEST=/etc/kitsu/public/instance-manifest.json
KITSU_SPOOL_DIR=/var/lib/kitsu/public-gateway/spool
KITSU_SPOOL_MAX_BYTES=536870912
KITSU_SEGMENT_MAX_BYTES=4194304
KITSU_MAX_FRAME_BYTES=524288
KITSU_FRAME_TIMEOUT_SECONDS=15
KITSU_BOOTSTRAP_CONCURRENCY_LIMIT=4
KITSU_STEADY_CONCURRENCY_LIMIT=256
KITSU_MDNS=false
