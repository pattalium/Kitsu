# Deliberately invalid: replace with the owner gateway's provisioned UUID.
KITSU_GATEWAY_ID=00000000-0000-0000-0000-000000000000
# Private mode fails closed unless both device listeners use explicit LAN,
# link-local, or loopback IPs. Replace this documentation address with the
# gateway host's actual LAN IP; never use 0.0.0.0 in private mode.
KITSU_DEPLOYMENT_SCOPE=private
KITSU_LISTEN=192.168.1.10:7443
KITSU_BOOTSTRAP_LISTEN=192.168.1.10:7442
KITSU_ADMIN_LISTEN=127.0.0.1:7444
KITSU_PUBLIC_NAME=Kitsu Home Gateway
KITSU_SERVER_CERT=./secrets/gateway-server.crt.pem
KITSU_SERVER_KEY=./secrets/gateway-server.key.pem
KITSU_DEVICE_CA=./secrets/device-ca.crt.pem
KITSU_BACKEND_URL=https://api.example.invalid
# Set only when the hosted backend uses a private CA.
# KITSU_BACKEND_CA=./secrets/backend-ca.crt.pem
KITSU_GATEWAY_CLIENT_IDENTITY=./secrets/gateway-client-identity.pem
# Public scope requires a separately provisioned strict manifest. Do not set it
# on a private instance; use `.env.public.example` for the public contract.
# KITSU_PUBLIC_INSTANCE_MANIFEST=/etc/kitsu/public/instance-manifest.json
KITSU_SPOOL_DIR=./data/spool
KITSU_SPOOL_MAX_BYTES=536870912
KITSU_SEGMENT_MAX_BYTES=4194304
KITSU_MAX_FRAME_BYTES=524288
KITSU_FRAME_TIMEOUT_SECONDS=15
KITSU_BOOTSTRAP_CONCURRENCY_LIMIT=4
KITSU_STEADY_CONCURRENCY_LIMIT=256
KITSU_MDNS=true
