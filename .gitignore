# Firmware and native host-test outputs
.pio/
*.obj
*.exe
*.pdb

# Local hardware/release evidence (never source release manifests)
/release-artifacts/

# Rust
platform/backend/target/
platform/gateway/target/
__pycache__/
*.pyc

# Web
platform/web/node_modules/
platform/web/dist/
platform/web/.next/
platform/flash-site/node_modules/
platform/flash-site/dist/
/tools/demo_wasm/full/dist/
/.agent-resources/

# Android / iOS generated products
platform/mobile/android/.gradle/
platform/mobile/android/**/build/
*.aab
*.idsig
platform/mobile/ios/*.xcodeproj/
platform/mobile/ios/DerivedData/

# Runtime state and local configuration
.env
.env.local
platform/**/data/
platform/**/secrets/
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx
/platform/mobile/android/local.properties

# Unlockable pet bundles are private backend data.  They must never become a
# public-site asset or a GitHub-hosted repository/release artifact.
/assets/wild-companion-sources/
/assets/wild-pack-evidence/
/assets/wild-packs/*.k868
/platform/public-site/unlock/assets/*.k868

# Public release verification key (not a private credential)
!platform/public-site/downloads/update-ed25519-public.pem

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
